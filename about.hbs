<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Third-party licenses</title>
<style>
body{font:15px/1.5 system-ui,sans-serif;max-width:960px;margin:0 auto;padding:24px;color:#1a1d23}
pre{background:#f4f5f7;padding:12px;white-space:pre-wrap;font-size:13px}
.license{border-top:1px solid #e3e6ea;margin-top:24px}
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>This binary includes the following third-party Rust crates. Their licenses are reproduced below.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>All license texts</h2>
{{#each licenses}}
<div class="license">
<h3 id="{{id}}">{{name}}</h3>
<h4>Used by:</h4>
<ul>
{{#each used_by}}
<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</div>
{{/each}}
</body>
</html>
